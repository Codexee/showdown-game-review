{
  "_about": "Keyword hints for .claude/hooks/skill_suggest.py. Each pattern is a case-insensitive regex. The hook fires on every prompt; these matches only help Claude pick.",
  "triggers": [
    { "skill": "systematic-debugging", "why": "find the root cause before changing code",
      "patterns": ["\\bbug\\b", "\\berror\\b", "\\bbroken\\b", "not working", "doesn'?t work", "\\bfail(s|ed|ing)?\\b", "\\bcrash", "stack ?trace", "exception", "\\bnan\\b", "loss (is )?(exploding|diverg|stuck)", "\\bfix (it|this|the)\\b"] },
    { "skill": "interview", "why": "turn this into a locked spec in .plans/",
      "patterns": ["\\bspec\\b", "requirements", "\\bplan\\b", "grill me", "scope (it|this|the)", "\\broadmap\\b", "\\btimeline\\b"] },
    { "skill": "anthropic-skills:deep-research", "why": "research many sources (GitHub, Smogon, papers) and write one cited report",
      "patterns": ["\\bresearch\\b", "state of the art", "cutting edge", "\\bpapers?\\b", "\\bsmogon\\b", "what (do|does) .* use", "compare (bots|models|approaches)"] },
    { "skill": "prototype", "why": "answer the question with a throwaway prototype first",
      "patterns": ["prototype", "mock ?up", "quick test", "small[- ]scale", "proof of concept", "\\bpoc\\b", "try (a few|some|different)"] },
    { "skill": "codex", "why": "get Codex's review or a second implementation of Python/training code",
      "patterns": ["review (my|the|this) (code|diff|changes)", "second opinion", "\\btrain(ing)?\\b", "\\bmodel\\b", "\\bnetwork\\b", "\\bpoke-?env\\b", "\\bbackend\\b", "\\bparser\\b"] },
    { "skill": "parallelize", "why": "split the locked spec into workstreams with one agent each",
      "patterns": ["split (up )?the work", "in parallel", "start (the )?build", "worktrees?", "\\bworkstreams?\\b", "fan out"] },
    { "skill": "handoff", "why": "write a handoff doc so the next session can continue",
      "patterns": ["hand ?off", "take over", "pick (this|it) up (later|tomorrow)", "going to (bed|sleep)", "new session"] },
    { "skill": "frontend-design", "why": "set a deliberate visual direction for the replay viewer",
      "patterns": ["new (page|screen|view|component)", "design the", "build (the|a) (ui|page|screen|viewer|board)", "look and feel", "\\bviewer\\b"] },
    { "skill": "dataviz", "why": "draw the eval bar and eval graph as one consistent chart system",
      "patterns": ["eval ?bar", "eval(uation)? graph", "\\bchart\\b", "\\bgraph\\b", "\\bplot\\b", "win ?(rate|prob)"] },
    { "skill": "pick-ui-library", "why": "pick the library for charts, replay playback or UI pieces",
      "patterns": ["which library", "\\blibrary\\b", "\\bframework\\b"] },
    { "skill": "better-interface", "why": "run a full UI audit",
      "patterns": ["audit (the )?ui", "\\bpolish\\b", "looks (bad|off|ugly|cheap)", "make it look (better|good)"] },
    { "skill": "animate", "why": "build the motion with exact curves and durations",
      "patterns": ["animat", "transition", "\\bmotion\\b", "fade in"] },
    { "skill": "agent-browser", "why": "check it in a real browser or pull pages from Showdown",
      "patterns": ["check the (page|site|app)", "does (it|this) (work|load)", "\\bconsole\\b", "screenshot", "click through", "scrape", "download replays"] },
    { "skill": "webapp-testing", "why": "write a repeatable Playwright test",
      "patterns": ["\\bplaywright\\b", "regression", "repeatable test", "automated test", "\\be2e\\b"] },
    { "skill": "ste", "why": "explain it in Standard Technical English",
      "patterns": ["explain", "what does .* mean", "confus", "\\bjargon\\b", "simpler terms", "\\bdocs?\\b"] },
    { "skill": "humanizer", "why": "remove AI writing tells from prose people will read",
      "patterns": ["write-?up", "\\breadme\\b", "\\bblurb\\b", "\\bpost\\b"] }
  ]
}
